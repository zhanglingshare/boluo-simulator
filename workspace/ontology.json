  "link_rules": [
    {"id": "rule-stock-flow-lag", "kind": "puzzle", "when": "走弱/下行的投资类指标(如 fai 利空) 与 新投产/点火项目(news, industry) 同期出现", "question_tpl": "投资在走弱，为什么仍有新项目投产？", "frame": "stock-flow-lag"},
